DATABASE_URL=sqlite:///./app.db
FRONTEND_ORIGIN=http://localhost:5173

# No key is needed to run the app. Which backend runs the assistant:
# "scripted" (rule-based, no model: answers price questions from the
# invoices), "openai" (any hosted OpenAI-compatible API), "anthropic",
# "ollama" (a local model) or "none" (the assistant is off). Left empty, it
# follows the keys below: ANTHROPIC_API_KEY, else LLM_API_KEY, else scripted.
# A model adds free-form answers and the reading of invoice photos.
LLM_PROVIDER=

# Claude (used with LLM_PROVIDER=anthropic, or when this is set and
# LLM_PROVIDER is empty).
ANTHROPIC_API_KEY=

# Hosted OpenAI-compatible APIs (used with LLM_PROVIDER=openai, or when
# LLM_API_KEY is set and LLM_PROVIDER is empty). LLM_MODEL
# has no default. The base URL defaults to Google Gemini's
# (key at https://aistudio.google.com/apikey).
# For Groq: LLM_BASE_URL=https://api.groq.com/openai/v1, a Groq key and model.
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=
# LLM_TIMEOUT_SECONDS=120

# Local models via Ollama (used when LLM_PROVIDER=ollama).
# OLLAMA_MODEL must support tool calling -- check `ollama show <model>`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=300
# Sent with every request so Ollama never reloads or unloads the model mid-run.
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m

# Cap on tool round-trips per run.
AGENT_MAX_TOOL_ROUNDS=12
# How many Boss delegations from one turn run at once. Start the Ollama server
# with OLLAMA_NUM_PARALLEL at least this high, or they queue on the server.
AGENT_MAX_PARALLEL_TOOLS=4

# Whether an empty database gets the sample restaurant (suppliers, stock,
# menu, staff, orders). Set false for a real restaurant's own instance.
SEED_SAMPLE_DATA=true

# Whether new restaurants can sign up from the landing page, each with its own
# owner account and its own separate data. Off: this is one restaurant's
# site -- its owner signs up first, and then nobody else can. Either way a
# restaurant's team joins with invite links from Profile -> Team access.
ALLOW_SIGNUP=false

# Encrypts two-step sign-in secrets. Set a long random value in production and
# never change it. Unset, a fixed development key is used.
# SECRET_KEY=
# Owners and admins must use two-step sign-in (never in DEMO_MODE).
REQUIRE_MFA=true

# Error alerts. Set to a Sentry project's DSN to be emailed about new errors
# (API, agent runs, and crashes in people's browsers). Blank: nothing is sent.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Who owners and staff contact for help; shown on the Help page when set.
# SUPPORT_EMAIL=
# SUPPORT_URL=

# How much the server logs: DEBUG, INFO (default), WARNING, ERROR.
# LOG_LEVEL=INFO

# Where owners forward supplier invoices, shown on the Invoices page. Leave
# empty unless this site has a mailbox that feeds invoices in; forwarding
# itself isn't built in yet, so an address here needs something reading it.
INVOICE_FORWARD_ADDRESS=

# Reading a photo or PDF of an invoice into lines. With ANTHROPIC_API_KEY,
# Claude reads both. With LLM_API_KEY, the model in LLM_MODEL does: a photo as
# an image (Gemini's models read them; pick one that does), a PDF as its text.
# With no model, a PDF that carries text is read by rule and photos are typed
# up. INVOICE_READER_MODEL pins a different model for reading than for the
# assistant (unset: claude-sonnet-4-5 for Claude, LLM_MODEL otherwise).
# INVOICE_READER_MODEL=

# The weekly digest mail. Sent through any mailbox over SMTP -- a Gmail
# address with an app password (Google account -> Security -> 2-Step
# Verification -> App passwords) costs nothing and needs no domain -- or
# through Resend (https://resend.com, needs a domain you own). With neither
# it's printed to the server log, so a laptop behaves the same.
# DIGEST_CRON runs on each restaurant's own clock: Monday 6am by default.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# RESEND_API_KEY=
# The sender; unset, the SMTP mailbox.
# MAIL_FROM=FullHouse <you@gmail.com>
# DIGEST_CRON=0 6 * * 1
# Lets an outside scheduler (Render cron, GitHub Actions) mail the digests with
# POST /api/v1/prices/digest/cron and the header X-Cron-Secret.
# CRON_SECRET=
# Where links in mail point. Defaults to Render's RENDER_EXTERNAL_URL, else the
# first FRONTEND_ORIGIN.
# PUBLIC_URL=

# The job queue. The web process runs worker threads itself by default; set
# WORKER_INPROCESS=false and run `python -m app.worker` beside it to scale apart.
# WORKER_INPROCESS=true
# WORKER_THREADS=2
# JOB_LEASE_SECONDS=300
# One JSON object per log line, with restaurant_id, job_id and run_id: LOG_FORMAT=json
# LOG_FORMAT=text
# Who may open the ops tables at /api/v1/platform/ops (comma-separated emails).
# SUPERUSER_EMAILS=
# Uploaded documents and invoice files; local disk unless S3_BUCKET (and
# S3_ENDPOINT_URL for MinIO or another S3-compatible store) is set.
# STORAGE_DIR=./data/files
# S3_BUCKET=
# S3_ENDPOINT_URL=

# Bill.com (Connect v3). All four set: "Connect Bill.com" pulls bills with their
# line items, once each. BILLCOM_ENVIRONMENT is sandbox (default) or production.
# Point a Bill.com webhook for bill.created and bill.updated at
# POST /api/v1/prices/billcom/webhook with the header X-Billcom-Secret.
# BILLCOM_USERNAME=
# BILLCOM_PASSWORD=
# BILLCOM_ORG_ID=
# BILLCOM_DEV_KEY=
# BILLCOM_ENVIRONMENT=sandbox
# BILLCOM_WEBHOOK_SECRET=
