DATABASE_URL=sqlite:///./app.db
FRONTEND_ORIGIN=http://localhost:5173
ANTHROPIC_API_KEY=

# Which backend runs the agents: "anthropic", "openai" (any hosted
# OpenAI-compatible API), "ollama" or "scripted"
LLM_PROVIDER=anthropic

# Hosted OpenAI-compatible APIs (used when LLM_PROVIDER=openai). The defaults
# are Google Gemini's free tier: get a key at https://aistudio.google.com/apikey.
# For Groq: LLM_BASE_URL=https://api.groq.com/openai/v1, a Groq key and model.
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash
# LLM_TIMEOUT_SECONDS=120

# Local models via Ollama (used when LLM_PROVIDER=ollama).
# OLLAMA_MODEL must support tool calling -- check `ollama show <model>`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=300
# Sent with every request so Ollama never reloads or unloads the model mid-run.
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m

# Cap on tool round-trips per run.
AGENT_MAX_TOOL_ROUNDS=12
# How many Boss delegations from one turn run at once. Start the Ollama server
# with OLLAMA_NUM_PARALLEL at least this high, or they queue on the server.
AGENT_MAX_PARALLEL_TOOLS=4

# Whether an empty database gets the sample restaurant (suppliers, stock,
# menu, staff, orders). Set false for a real restaurant's own instance.
SEED_SAMPLE_DATA=true

# Whether anyone who reaches the site can create an account in the restaurant.
# Off: the owner signs up first, and the team joins with invite links from
# Profile -> Team access.
ALLOW_SIGNUP=false
